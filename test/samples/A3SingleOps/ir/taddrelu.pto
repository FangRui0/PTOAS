module {
  func.func @taddrelu_a3(%src0_ptr: !pto.ptr<f32>, %src1_ptr: !pto.ptr<f32>,
      %dst_ptr: !pto.ptr<f32>) attributes {pto.entry} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c16 = arith.constant 16 : index
    %src0_view = pto.make_tensor_view %src0_ptr, shape = [%c16, %c16],
      strides = [%c16, %c1] : !pto.tensor_view<16x16xf32>
    %src1_view = pto.make_tensor_view %src1_ptr, shape = [%c16, %c16],
      strides = [%c16, %c1] : !pto.tensor_view<16x16xf32>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c16, %c16],
      strides = [%c16, %c1] : !pto.tensor_view<16x16xf32>
    %src0_part = pto.partition_view %src0_view, offsets = [%c0, %c0],
      sizes = [%c16, %c16]
      : !pto.tensor_view<16x16xf32> -> !pto.partition_tensor_view<16x16xf32>
    %src1_part = pto.partition_view %src1_view, offsets = [%c0, %c0],
      sizes = [%c16, %c16]
      : !pto.tensor_view<16x16xf32> -> !pto.partition_tensor_view<16x16xf32>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0],
      sizes = [%c16, %c16]
      : !pto.tensor_view<16x16xf32> -> !pto.partition_tensor_view<16x16xf32>
    %src0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
      v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
      v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
      v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%src0_part : !pto.partition_tensor_view<16x16xf32>)
      outs(%src0 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16,
        v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%src1_part : !pto.partition_tensor_view<16x16xf32>)
      outs(%src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16,
        v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.taddrelu ins(%src0, %src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=16,
      cols=16, v_row=16, v_col=16, blayout=row_major, slayout=none_box,
      fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
      v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16, v_row=16,
        v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tstore ins(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=16, cols=16,
      v_row=16, v_col=16, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst_part : !pto.partition_tensor_view<16x16xf32>)
    return
  }
}

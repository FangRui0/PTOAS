// Test pto-lower-loop-hints diagnostics for malformed hint attributes.
//
// All errors are reported in one run (the pass collects diagnostics across
// loops before failing).

// RUN: not pto-test-opt --pto-lower-loop-hints %s 2>&1 | FileCheck %s

module {
  // CHECK: error: unknown 'pto.unroll' value 'sometimes'; expected "enable", "disable", or "full"
  func.func @bad_value(%n: index) {
    %buf = memref.alloc() : memref<1xindex>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll = "sometimes"}
    return
  }

  // CHECK: error: 'pto.unroll' and 'pto.unroll_factor' are mutually exclusive on one loop
  func.func @conflicting(%n: index) {
    %buf = memref.alloc() : memref<1xindex>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll = "enable", pto.unroll_factor = 4 : i32}
    return
  }

  // CHECK: error: 'pto.unroll_factor' must be a positive integer, got 0
  func.func @bad_factor(%n: index) {
    %buf = memref.alloc() : memref<1xindex>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll_factor = 0 : i32}
    return
  }

  // A wider integer attribute does not fit the signless i32 contract and
  // would silently truncate in the 32-bit LLVM loop metadata.
  // CHECK: error: 'pto.unroll_factor' must be a signless i32 attribute, got 'i64'
  func.func @bad_factor_type(%n: index) {
    %buf = memref.alloc() : memref<1xindex>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll_factor = 4 : i64}
    return
  }

  // CHECK: error: 'pto.unroll_factor' must be a signless i32 attribute, got 'i64'
  func.func @bad_factor_overflow(%n: index) {
    %buf = memref.alloc() : memref<1xindex>
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    scf.for %i = %c0 to %n step %c1 {
      memref.store %i, %buf[%c0] : memref<1xindex>
    } {pto.unroll_factor = 2147483648 : i64}
    return
  }
}

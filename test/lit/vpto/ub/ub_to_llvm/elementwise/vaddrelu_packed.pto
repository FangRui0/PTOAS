// Verify the A3/HVVM VADDRELU config word packing used by BiSheng:
//   dstBlk[7:0], src0Blk[15:8], src1Blk[23:16], dstRep[31:24],
//   src0Rep[39:32], src1Rep[47:40], reserved[55:48]=0, repeat[63:56].
// RUN: ptoas --pto-arch=a3 --pto-backend=vpto --emit-vpto-llvm-ir %s -o %t --mlir-print-ir-after=convert-func-to-llvm 2>&1 | FileCheck %s

module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  // CHECK-LABEL: llvm.func @ub_vaddrelu_packed_mix_aiv(
  func.func @ub_vaddrelu_packed(%dst: !pto.ptr<f32, ub>, %src0: !pto.ptr<f32, ub>, %src1: !pto.ptr<f32, ub>) attributes {pto.aicore} {
    %c2 = arith.constant 2 : i64
    %c3 = arith.constant 3 : i64
    %c4 = arith.constant 4 : i64
    %c5 = arith.constant 5 : i64
    %c6 = arith.constant 6 : i64
    %c7 = arith.constant 7 : i64
    %c8 = arith.constant 8 : i64
    // CHECK: llvm.mlir.constant(0 : i64)
    // CHECK: llvm.mlir.constant(255 : i64)
    // CHECK: %[[REPEAT:.*]] = llvm.mlir.constant(2 : i64)
    // CHECK: %[[SH56:.*]] = llvm.mlir.constant(56 : i64)
    // CHECK: llvm.shl %[[REPEAT]], %[[SH56]]
    // CHECK: llvm.mlir.constant(3 : i64)
    // CHECK: %[[SRC0BLK:.*]] = llvm.mlir.constant(4 : i64)
    // CHECK: %[[SH8:.*]] = llvm.mlir.constant(8 : i64)
    // CHECK: llvm.shl %[[SRC0BLK]], %[[SH8]]
    // CHECK: %[[SRC1BLK:.*]] = llvm.mlir.constant(5 : i64)
    // CHECK: %[[SH16:.*]] = llvm.mlir.constant(16 : i64)
    // CHECK: llvm.shl %[[SRC1BLK]], %[[SH16]]
    // CHECK: %[[DSTREP:.*]] = llvm.mlir.constant(6 : i64)
    // CHECK: %[[SH24:.*]] = llvm.mlir.constant(24 : i64)
    // CHECK: llvm.shl %[[DSTREP]], %[[SH24]]
    // CHECK: %[[SRC0REP:.*]] = llvm.mlir.constant(7 : i64)
    // CHECK: %[[SH32:.*]] = llvm.mlir.constant(32 : i64)
    // CHECK: llvm.shl %[[SRC0REP]], %[[SH32]]
    // CHECK: %[[SRC1REP:.*]] = llvm.mlir.constant(8 : i64)
    // CHECK: %[[SH40:.*]] = llvm.mlir.constant(40 : i64)
    // CHECK: llvm.shl %[[SRC1REP]], %[[SH40]]
    // CHECK: llvm.call @llvm.hivm.VADDRELU.f32({{.*}}, {{.*}}, {{.*}}, {{%.*}}) : (!llvm.ptr<6>, !llvm.ptr<6>, !llvm.ptr<6>, i64) -> ()
    // CHECK-NOT: pto.ub.
    pto.ub.vaddrelu %dst, %src0, %src1, %c2, %c3, %c4, %c5, %c6, %c7, %c8 : !pto.ptr<f32, ub>, !pto.ptr<f32, ub>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64, i64, i64
    return
  }
}

// RUN: ptoas --pto-arch=a3 --emit-pto-ir %s 2>&1 | FileCheck %s

module attributes {"pto.device-spec" = "Ascend910B3"} {
  func.func @a3_tsel_f32_tmp() attributes {pto.kernel_kind = #pto.kernel_kind<vector>} {
    %mask = pto.alloc_tile : !pto.tile_buf<vec, 32x32xi8>
    %src0 = pto.alloc_tile : !pto.tile_buf<vec, 32x32xf32>
    %src1 = pto.alloc_tile : !pto.tile_buf<vec, 32x32xf32>
    %tmp = pto.alloc_tile : !pto.tile_buf<vec, 32x32xf32>
    %dst = pto.alloc_tile : !pto.tile_buf<vec, 32x32xf32>
    pto.tsel ins(%mask, %src0, %src1, %tmp : !pto.tile_buf<vec, 32x32xi8>, !pto.tile_buf<vec, 32x32xf32>, !pto.tile_buf<vec, 32x32xf32>, !pto.tile_buf<vec, 32x32xf32>)
             outs(%dst : !pto.tile_buf<vec, 32x32xf32>)
    return
  }
}

// CHECK-LABEL: func.func @a3_tsel_f32_tmp
// CHECK: pto.tsel

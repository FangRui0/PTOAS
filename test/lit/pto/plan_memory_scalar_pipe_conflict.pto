// RUN: ptoas --pto-level=level2 --pto-arch=a3 --emit-pto-ir \
// RUN:   --mlir-print-ir-after=pto-plan-memory %s 2>&1 1>/dev/null \
// RUN:   | FileCheck %s --check-prefix=PLAN
// RUN: ptoas --pto-level=level2 --pto-arch=a3 --enable-insert-sync %s -o - 2>&1 \
// RUN:   | FileCheck %s --check-prefix=SYNC

module {
  func.func @scalar_pipe_conflict() -> f32 {
    %c0 = arith.constant 0 : index
    %scalar = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>
    %value = pto.tgetval ins(%scalar, %c0 : !pto.tile_buf<vec, 16x16xf32>, index)
      outs : f32

    %vector = pto.alloc_tile : !pto.tile_buf<vec, 16x16xf32>
    pto.tprint ins(%vector : !pto.tile_buf<vec, 16x16xf32>)
    return %value : f32
  }
}

// The scalar-touched tile and the vector tile have non-overlapping liveness, so
// PlanMemory coalesces both onto address 0. Safety comes from InsertSync, which
// guards the scalar read against the later vector use with a PIPE_S->PIPE_V flag
// rather than from keeping the tiles at separate addresses.
// PLAN: %[[ZERO:.*]] = arith.constant 0 : i64
// PLAN: pto.alloc_tile addr = %[[ZERO]] : !pto.tile_buf<vec, 16x16xf32>
// PLAN: pto.alloc_tile addr = %[[ZERO]] : !pto.tile_buf<vec, 16x16xf32>

// SYNC:      GetValue(
// SYNC:      set_flag(PIPE_S, PIPE_V, EVENT_ID[[SV:[0-9]+]]);
// SYNC:      wait_flag(PIPE_S, PIPE_V, EVENT_ID[[SV]]);
// SYNC-NEXT: TPRINT(

// RUN: ptoas --pto-level=level3 --pto-arch=a3 --enable-insert-sync %s -o - | FileCheck %s

module {
  func.func private @taddrelu_a3(%src0: !pto.tile_buf<vec, 1x16xf32>,
      %src1: !pto.tile_buf<vec, 1x16xf32>,
      %dst: !pto.tile_buf<vec, 1x16xf32>) {
    pto.taddrelu ins(%src0, %src1 : !pto.tile_buf<vec, 1x16xf32>,
      !pto.tile_buf<vec, 1x16xf32>)
      outs(%dst : !pto.tile_buf<vec, 1x16xf32>)
    return
  }
}

// CHECK-LABEL: taddrelu_a3(
// CHECK: TADD([[DST:v[0-9]+]], [[SRC0:v[0-9]+]], [[SRC1:v[0-9]+]]);
// CHECK-NEXT: pipe_barrier(PIPE_V);
// CHECK-NEXT: TRELU([[DST]], [[DST]]);

// RUN: not ptoas --pto-arch=a3 %s -o /dev/null 2>&1 | FileCheck %s

module {
  func.func @tfillpad_explicit_mode_invalid(
      %src: !pto.tile_buf<loc=mat, dtype=bf16, rows=16, cols=64, v_row=16, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=1>,
      %dst: !pto.tile_buf<loc=mat, dtype=bf16, rows=16, cols=64, v_row=16, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=1>) {
    pto.tfillpad ins(%src : !pto.tile_buf<loc=mat, dtype=bf16, rows=16, cols=64, v_row=16, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=1>)
                 outs(%dst : !pto.tile_buf<loc=mat, dtype=bf16, rows=16, cols=64, v_row=16, v_col=64, blayout=col_major, slayout=row_major, fractal=512, pad=1>)
                 {mode = "expand"}
    return
  }
}

// CHECK: error: 'pto.tfillpad' op does not accept 'mode'; PTOAS infers TFILLPAD lowering from physical shape and planned addresses

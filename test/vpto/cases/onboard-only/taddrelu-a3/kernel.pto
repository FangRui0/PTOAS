module attributes {pto.target_arch = "a3", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @taddrelu_a3_kernel(%src0_ptr: !pto.ptr<f32, gm>,
      %src1_ptr: !pto.ptr<f32, gm>, %dst_ptr: !pto.ptr<f32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c64 = arith.constant 64 : index
    %src0_view = pto.make_tensor_view %src0_ptr, shape = [%c1, %c64],
      strides = [%c64, %c1] : !pto.tensor_view<1x64xf32>
    %src1_view = pto.make_tensor_view %src1_ptr, shape = [%c1, %c64],
      strides = [%c64, %c1] : !pto.tensor_view<1x64xf32>
    %dst_view = pto.make_tensor_view %dst_ptr, shape = [%c1, %c64],
      strides = [%c64, %c1] : !pto.tensor_view<1x64xf32>
    %src0_part = pto.partition_view %src0_view, offsets = [%c0, %c0], sizes = [%c1, %c64]
      : !pto.tensor_view<1x64xf32> -> !pto.partition_tensor_view<1x64xf32>
    %src1_part = pto.partition_view %src1_view, offsets = [%c0, %c0], sizes = [%c1, %c64]
      : !pto.tensor_view<1x64xf32> -> !pto.partition_tensor_view<1x64xf32>
    %dst_part = pto.partition_view %dst_view, offsets = [%c0, %c0], sizes = [%c1, %c64]
      : !pto.tensor_view<1x64xf32> -> !pto.partition_tensor_view<1x64xf32>
    %src0 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
      v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %src1 = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
      v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    %dst = pto.alloc_tile : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
      v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>
    pto.tload ins(%src0_part : !pto.partition_tensor_view<1x64xf32>)
      outs(%src0 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1,
        v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.tload ins(%src1_part : !pto.partition_tensor_view<1x64xf32>)
      outs(%src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1,
        v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.taddrelu ins(%src0, %src1 : !pto.tile_buf<loc=vec, dtype=f32, rows=1,
      cols=64, v_row=1, v_col=64, blayout=row_major, slayout=none_box,
      fractal=512, pad=0>, !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
      v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64, v_row=1,
        v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.tstore ins(%dst : !pto.tile_buf<loc=vec, dtype=f32, rows=1, cols=64,
      v_row=1, v_col=64, blayout=row_major, slayout=none_box, fractal=512, pad=0>)
      outs(%dst_part : !pto.partition_tensor_view<1x64xf32>)
    return
  }
}
